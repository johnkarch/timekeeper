# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is already gitignored — never commit real keys.
#
# Where to find these: in your Supabase project dashboard, go to
# Project Settings -> Data API (older dashboards call this "API").

# Project URL, e.g. https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project "anon" / "public" key (safe to expose in the browser — access is
# controlled by Row Level Security policies on your tables, not by this key
# being secret).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
